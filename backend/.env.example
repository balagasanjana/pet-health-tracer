# MongoDB Connection String
# For local development: mongodb://localhost:27017/pet
# For production (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/pet
MONGO_URI=mongodb://localhost:27017/pet

# Node Environment
NODE_ENV=development

# CORS Origin (for frontend URL)
# Local development: http://localhost:3000
# Production Render: https://your-frontend-name.onrender.com
CORS_ORIGIN=http://localhost:3000

# Port (Render assigns this automatically)
PORT=5000
